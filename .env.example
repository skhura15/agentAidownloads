# ============================================================================
# Microsoft Agent Framework Configuration
# ============================================================================

# Choose your deployment model:
# Option 1: Microsoft Foundry (formerly Azure AI Foundry) - Recommended for production
# Option 2: Azure OpenAI - Direct Azure OpenAI Service

# Set to "true" to use Microsoft Foundry, "false" for Azure OpenAI
USE_FOUNDRY=false

# Microsoft Foundry Settings (when USE_FOUNDRY=true)
FOUNDRY_PROJECT_ENDPOINT=https://your-project.eastus.inference.ai.azure.com
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o

# ============================================================================
# Azure OpenAI Configuration (when USE_FOUNDRY=false)
# ============================================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Key Vault (Optional)
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# Azure Application Insights (Optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://...

# Environment
ENVIRONMENT=dev

# Redis (Optional - for distributed state)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Agent Configuration
MAX_AGENT_ITERATIONS=10
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=1000
